# Copy to .env in the repository root on the server and fill in the values.
# Generate secrets with:
#   openssl rand -hex 32                              (JWT_SECRET_KEY, POSTGRES_PASSWORD)
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"   (TOKEN_ENCRYPTION_KEY)

# --- Site ---
SITE_DOMAIN=synctask.pasqora.cl

# --- Application ---
APP_ENV=production
BACKEND_CORS_ORIGINS=https://synctask.pasqora.cl
FRONTEND_URL=https://synctask.pasqora.cl

# --- PostgreSQL ---
POSTGRES_USER=synctask
POSTGRES_PASSWORD=
POSTGRES_DB=synctask
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
TOKEN_ENCRYPTION_KEY=

# --- First administrator ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

# --- Google (add this exact URI in Google Cloud Console > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://synctask.pasqora.cl/api/integrations/google/callback

# --- Microsoft ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
