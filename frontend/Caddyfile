# SITE_DOMAIN comes from the environment (docker-compose.prod.yml).
# TLS uses a Cloudflare Origin Certificate; set Cloudflare SSL/TLS mode to "Full (strict)".
{
	servers {
		# Cloudflare edge ranges (https://www.cloudflare.com/ips/) plus the Docker network.
		# Only requests arriving from these keep the client IP set below; anyone else is
		# recorded with their own address.
		trusted_proxies static private_ranges \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$SITE_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	# Real client IP for the audit log: Cloudflare sends it in CF-Connecting-IP. Replacing
	# X-Forwarded-For (instead of extending it) keeps clients from spoofing the address.
	request_header X-Forwarded-For {http.request.header.CF-Connecting-IP}

	# API: /api/auth/me -> backend:8000/auth/me
	handle_path /api/* {
		reverse_proxy backend:8000 {
			# Stream assistant replies (Server-Sent Events) without buffering.
			flush_interval -1
		}
	}

	# Single-page app: unknown paths fall back to index.html for React Router.
	handle {
		root * /srv
		encode zstd gzip
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
