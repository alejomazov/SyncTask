# Copy to .env and fill in the values. Never commit .env.

# --- Application ---
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_USER=synctask
POSTGRES_PASSWORD=
POSTGRES_DB=synctask
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (Celery broker and result backend) ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
TOKEN_ENCRYPTION_KEY=

# --- First administrator (python -m app.scripts.create_admin) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

# --- Google (OAuth 2.0, Calendar, Gmail) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft (OAuth 2.0, Graph) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Google Gemini ---
GEMINI_API_KEY=

# --- Frontend ---
VITE_API_URL=http://localhost:8000
